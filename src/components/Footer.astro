---
const year = new Date().getFullYear();
---
<footer>
  <div class="inner">
    <a href="/" class="brand">Ignacio Pineda</a>
    <nav class="links">
      <a href="/experience">Experience</a>
      <a href="/education">Education</a>
      <a href="/writing">Writing</a>
      <a href="/press">Press</a>
      <a href="/now">Now</a>
      <a href="/contact">Contact</a>
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>
  <p class="meta">&copy; {year} · Built with Astro · Static · No cookies, no trackers</p>
</footer>

<style>
  footer {
    max-width: var(--page); margin: 0 auto; width: 100%;
    padding: var(--s5) var(--s3) var(--s6);
    border-top: 1px solid var(--border);
  }
  .inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--s3); flex-wrap: wrap; margin-bottom: var(--s2);
  }
  .brand { display: inline-flex; align-items: center; color: var(--t); font-weight: 600; font-size: .9rem; }
  .brand:hover { color: var(--accent); }
  .links { display: flex; gap: var(--s3); flex-wrap: wrap; }
  .links a { color: var(--t-mut); font-family: var(--font-mono); font-size: .8rem; }
  .links a:hover { color: var(--accent); }
  .meta { font-family: var(--font-mono); font-size: .72rem; color: var(--t-sub); margin: 0; }
</style>

---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Home' },
  { href: '/experience', label: 'Experience' },
  { href: '/writing', label: 'Writing' },
  { href: '/now', label: 'Now' },
  { href: '/contact', label: 'Contact' },
];
---
<header class="bar">
  <nav>
    <a href="/" class="brand">
      <span class="brand-name">Ignacio Pineda</span>
      <span class="brand-sep">—</span>
      <span class="brand-role">Security Engineer</span>
    </a>
    <ul>
      {links.map(({ href, label }) => {
        const active = pathname === href || (href !== '/' && pathname.startsWith(href));
        return (
          <li>
            <a href={href} aria-current={active ? 'page' : undefined}>{label}</a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>

<style>
  .bar {
    position: sticky; top: 0; z-index: 50;
    background: rgba(11,17,32,.7);
    backdrop-filter: blur(12px) saturate(160%);
    -webkit-backdrop-filter: blur(12px) saturate(160%);
    border-bottom: 1px solid var(--border);
  }
  nav {
    max-width: var(--page); margin: 0 auto;
    padding: .9rem var(--s3);
    display: flex; align-items: center; justify-content: space-between; gap: var(--s3);
  }
  .brand {
    display: inline-flex; align-items: baseline; gap: .5em;
    color: var(--t-hi); font-weight: 600; font-size: 1rem;
    letter-spacing: -0.01em;
  }
  .brand-sep { color: var(--t-sub); font-weight: 400; }
  .brand-role { color: var(--accent); font-weight: 500; }
  .brand:hover .brand-name { color: var(--accent); }
  .brand-name { transition: color var(--dur) var(--ease); }

  ul { display: flex; gap: .2rem; list-style: none; margin: 0; padding: 0; }
  ul a {
    display: block; color: var(--t-mut); font-size: .9rem; font-weight: 450;
    padding: .4em .75em; border-radius: var(--r-sm);
    transition: color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  ul a:hover { color: var(--t-hi); }
  ul a[aria-current='page'] { color: var(--accent); }

  @media (max-width: 46rem) {
    nav { flex-direction: column; align-items: flex-start; gap: .6rem; padding: .7rem var(--s3); }
    .brand-sep, .brand-role { display: none; }
  }
  @media (max-width: 34rem) {
    ul { gap: .05rem; }
    ul a { padding: .35em .55em; font-size: .82rem; }
  }
</style>

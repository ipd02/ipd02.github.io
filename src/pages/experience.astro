---
import Base from '../layouts/Base.astro';

const roles = [
  {
    date: 'Oct 2025 — Present',
    title: 'Security & Privacy Engineer',
    org: 'Bending Spoons',
    url: 'https://bendingspoons.com',
    points: [
      'Detect, triage and respond to incidents on the SOC on-call rotation — from alert to containment and root-cause remediation.',
      'Harden the macOS fleet end to end: compliance baselines, least-privilege admin, and endpoint detection/telemetry with Jamf Pro and Jamf Protect.',
      'Build internal security tooling that automates detection, compliance monitoring and remediation across the organization.',
      'Own organization-wide vulnerability management across applications, dependencies and cloud.',
      'Run the security-awareness program — training and phishing simulations.',
      'Perform application and privacy security reviews, including black-box testing, of internal and public-facing systems.',
    ],
  },
  {
    date: 'Jul 2023 — Sep 2025',
    title: 'Cybersecurity R&D Engineer',
    org: 'NICS Lab',
    url: 'https://www.nics.uma.es',
    points: [
      'Designed and deployed a virtualized honeynet that captured and analyzed live attacks against smart-grid energy-management infrastructure (GEDERA).',
      'Reverse-engineered industrial/OT protocols — OCPP, Modbus, MQTT — to uncover vulnerabilities in EV-charging and smart-grid communications.',
      'Researched automotive security standards (UNECE R155, ISO/SAE 21434) and designed vehicle-security test architectures (5GVEC).',
    ],
  },
  {
    date: 'Apr — Oct 2022',
    title: 'Team Member',
    org: 'iGEM 2022 — University of Málaga',
    url: null,
    points: [
      'Selected to the University of Málaga\u2019s team in iGEM, the world\u2019s premier synthetic-biology competition (356 teams, 7,700+ participants, judged in Paris).',
      'Owned the team\u2019s web presence and the technical communication of its scientific results.',
    ],
  },
];
---
<Base
  title="Experience"
  description="Ignacio Pineda's professional experience in security engineering and cybersecurity R&D."
>
  <p class="eyebrow"><span class="n">01.</span> <span class="txt">Experience</span></p>
  <h1>Experience</h1>
  <p class="lead">Where I've worked and what I did there. <a href="/cv/Ignacio_Pineda_CV.pdf" class="inline-link">Full résumé (PDF)</a>.</p>

  <ol class="timeline">
    {roles.map((r) => (
      <li class="entry">
        <div class="date">{r.date}</div>
        <div class="body">
          <h3 class="role">
            {r.title}
            {r.url
              ? <> · <a href={r.url} class="org inline-link">{r.org}</a></>
              : <> · <span class="org">{r.org}</span></>}
          </h3>
          <ul>{r.points.map((p) => <li>{p}</li>)}</ul>
        </div>
      </li>
    ))}
  </ol>
</Base>

<style>
  h1 { margin-bottom: var(--s2); }
  .lead { margin-bottom: var(--s6); }

  .timeline { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--s6); }
  .entry { display: grid; grid-template-columns: 9rem 1fr; gap: var(--s3); }
  .date {
    font-family: var(--font-mono); font-size: .75rem; letter-spacing: .03em;
    color: var(--t-sub); padding-top: .35em; text-transform: uppercase;
  }
  .role { font-size: 1.15rem; color: var(--t-hi); margin: 0 0 var(--s2); }
  .org { color: var(--accent); }
  .body ul { margin: 0; padding: 0; list-style: none; }
  .body ul li {
    position: relative; padding-left: 1.4em; margin-bottom: var(--s2);
    color: var(--t); font-size: .98rem; line-height: 1.6;
  }
  .body ul li::before { content: '▹'; position: absolute; left: 0; color: var(--accent); }

  @media (max-width: 40rem) {
    .entry { grid-template-columns: 1fr; gap: var(--s1); }
    .date { padding-top: 0; }
  }
</style>

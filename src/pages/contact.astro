---
import Base from '../layouts/Base.astro';
import EmailObfuscated from '../components/EmailObfuscated.astro';
---
<Base
  title="Contact"
  description="Get in touch with Ignacio Pineda — email, GitHub, LinkedIn."
>
  <p class="eyebrow"><span class="n">04.</span> <span class="txt">Contact</span></p>
  <h1>Get in touch</h1>
  <p class="lead">I'm open to conversations about security roles across the EU. The fastest way to reach me is email.</p>

  <ul class="channels">
    <li>
      <span class="k">Email</span>
      <span class="v"><EmailObfuscated user="pinedadelgadoignacio" domain="gmail.com" /></span>
    </li>
    <li>
      <span class="k">GitHub</span>
      <a class="v inline-link" href="https://github.com/ipd02" rel="me">github.com/ipd02</a>
    </li>
    <li>
      <span class="k">LinkedIn</span>
      <a class="v inline-link" href="https://www.linkedin.com/in/ignacio-jacobo-pineda-delgado-013302325" rel="me">in/ignacio-jacobo-pineda-delgado</a>
    </li>
  </ul>
</Base>

<style>
  h1 { margin-bottom: var(--s3); }
  .lead { margin-bottom: var(--s6); }
  .channels { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .channels li {
    display: grid; grid-template-columns: 8rem 1fr; align-items: baseline; gap: var(--s2);
    padding: var(--s3) 0; border-top: 1px solid var(--border);
  }
  .channels li:last-child { border-bottom: 1px solid var(--border); }
  .k { font-family: var(--font-mono); font-size: .78rem; text-transform: uppercase; letter-spacing: .06em; color: var(--accent); }
  .v { font-family: var(--font-mono); font-size: 1rem; color: var(--t); overflow-wrap: anywhere; }
  @media (max-width: 34rem) { .channels li { grid-template-columns: 1fr; gap: .3rem; } }
</style>

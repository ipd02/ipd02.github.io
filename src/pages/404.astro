---
import Base from '../layouts/Base.astro';
---
<Base title="404" description="Page not found.">
  <article>
    <p class="code">404</p>
    <h1>Page not found</h1>
    <p class="lead">The page you're looking for doesn't exist — or moved.</p>
    <p><a href="/" class="inline-link">← Back home</a></p>
  </article>
</Base>

<style>
  .code {
    font-family: var(--font-mono); font-weight: 700; line-height: 1;
    font-size: clamp(4rem, 14vw, 8rem);
    color: var(--accent); margin: 0 0 var(--s2); letter-spacing: -0.04em;
  }
</style>

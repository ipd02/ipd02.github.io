---
import Base from './Base.astro';
import PostMeta from '../components/PostMeta.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  readingTime: string;
}

const { title, description, pubDate, tags, readingTime } = Astro.props;
---
<Base title={title} description={description}>
  <article class="post">
    <a class="back" href="/writing">← Writing</a>
    <h1>{title}</h1>
    <PostMeta date={pubDate} readingTime={readingTime} />
    {tags && tags.length > 0 && (
      <ul class="tags">
        {tags.map((tag) => <li>{tag}</li>)}
      </ul>
    )}
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .back {
    display: inline-block; color: var(--t-mut);
    font-family: var(--font-mono); font-size: .8rem;
    margin-bottom: var(--s3);
  }
  .back:hover { color: var(--accent); }

  .tags { display: flex; flex-wrap: wrap; gap: .4rem; list-style: none; padding: 0; margin: 0 0 var(--s5); }
  .tags li {
    font-family: var(--font-mono); font-size: .7rem; color: var(--accent);
    border: 1px solid var(--accent-line); border-radius: 999px; padding: .25em .7em; margin: 0;
  }

  .prose { color: var(--t); line-height: 1.8; }
  .prose :global(h2) { margin-top: var(--s5); }
  .prose :global(h3) { margin-top: var(--s4); }
  .prose :global(img) { max-width: 100%; height: auto; border-radius: var(--r); border: 1px solid var(--border); }
</style>

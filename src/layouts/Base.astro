---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Home uses a full-bleed hero, so it opts out of the standard padded main. */
  bare?: boolean;
}

const { title, description, ogImage = '/og.png', bare = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
const pageTitle = title === 'Ignacio Pineda' ? title : `${title} — Ignacio Pineda`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{pageTitle}</title>
    <meta name="description" content={description}>
    <meta name="theme-color" content="#0b1120">
    <link rel="canonical" href={canonicalUrl}>
    <meta http-equiv="X-Content-Type-Options" content="nosniff">
    <meta http-equiv="referrer" content="no-referrer">
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:title" content={pageTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImageUrl}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={pageTitle}>
    <meta name="twitter:description" content={description}>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><rect width='16' height='16' rx='3' fill='%230b1120'/><text x='8' y='12' font-family='monospace' font-weight='bold' font-size='9' fill='%235eead4' text-anchor='middle'>ip</text></svg>">
    <slot name="head" />
  </head>
  <body>
    <Nav />
    {bare ? <slot /> : <main><slot /></main>}
    <Footer />
  </body>
</html>

<style>
  main {
    flex: 1;
    width: 100%;
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--s7) var(--s3) var(--s8);
  }
</style>
